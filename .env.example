# Environment Variables
# Copy this file to .env and fill in your Neon database credentials

# Pooled connection URL (used by Prisma in serverless functions)
# Add ?pgbouncer=true to the connection string
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct connection URL (used by Prisma for migrations/introspection)
DIRECT_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"
